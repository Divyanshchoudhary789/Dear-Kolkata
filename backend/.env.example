# Server Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dearkolkata?retryWrites=true&w=majority

# JWT Secret (use strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
JWT_COOKIE_SAMESITE=strict

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo (Sendinblue) Email Service — Nodemailer via SMTP
# SMTP Host: smtp-relay.brevo.com  Port: 587
# Get API Key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_smtp_password_from_api_keys
BREVO_SENDER_EMAIL=noreply@dearkolkata.com
BREVO_SENDER_NAME=Dear Kolkata

# 2Factor.in SMS Service (for OTP delivery)
# Sign up at: https://2factor.in | Pricing: pay-per-SMS, no monthly fee
# Get API Key from: https://2factor.in/CP/ → API Keys
TWOFACTOR_API_KEY=your_2factor_api_key
# DLT-registered template name (required for Indian SMS after TRAI regulations)
# Create template in 2Factor dashboard under SMS → Templates
# Example: DKOLKATA_OTP  (must match exactly what's registered)
TWOFACTOR_TEMPLATE_NAME=AUTOGEN2

# Payment Gateway (Razorpay/Stripe/etc)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Get from Razorpay Dashboard → Settings → Webhooks → Webhook Secret
# Leave blank during development (signature check is skipped)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=10mb

# Business Logic Configuration
DEFAULT_CASHBACK_PERCENT=5
WELCOME_BONUS_AMOUNT=350
PAYOUT_DELAY_DAYS=7
SKU_CAP_DEFAULT=20

# Kolkata Pin Code Validation
KOLKATA_PIN_REGEX=^700\\d{3}$
