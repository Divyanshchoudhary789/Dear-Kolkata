# ── API Base URL ──────────────────────────────────────────────────────────────
# Development: point to local backend (Vite proxy is configured in vite.config.js)
# Use /api if using Vite proxy (recommended), or full URL for direct connection
VITE_API_BASE_URL=/api

# Production: set to your deployed backend URL
# VITE_API_BASE_URL=https://api.dearkolkata.com/api
